# Supabase project (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Vercel Cron: sent as `Authorization: Bearer <CRON_SECRET>` to /api/cron/chisel-day
CRON_SECRET=generate-a-long-random-string

# AES-256-GCM key for journal encryption, 32 bytes base64: `openssl rand -base64 32`
JOURNAL_ENCRYPTION_KEY=

# Stripe (Pro subscription skeleton)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...

# Public origin used in share links and magic-link redirects (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000
